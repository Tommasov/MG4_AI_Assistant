<?xml version="1.0" encoding="utf-8"?>
<!-- The vocabulary MG4 360 Camera uses, brought over so the two apps read the same way.

     The rule that matters, and the one this screen was breaking: a tonal surface means
     "you can press this". A notice with a button's background looks pressable and is not;
     a text field with one looks like a button and is not. So only buttons get a face, and
     everything else is separated by type size, colour and a hairline. -->
<resources>

    <!-- A group heading. Accent and caps do the work a box would otherwise be asked to do. -->
    <style name="SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/section_header_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- What a field is for, above the field. -->
    <style name="FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/row_gap</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/secondary_text_size</item>
    </style>

    <!-- No background. The platform's own underline is what says "type here", and it says it
         without borrowing the shape that means "press here". -->
    <style name="Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/field_margin_top</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/status_text_size</item>
    </style>

    <!-- Explanations. Quieter than the thing they explain, and never boxed. -->
    <style name="Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/field_margin_top</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/secondary_text_size</item>
    </style>

    <!-- The one notice that has to be read rather than skimmed, so it keeps the body colour
         while staying plain text. -->
    <style name="Notice" parent="Hint">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/status_text_size</item>
    </style>

    <!-- A service's state, beside its name. -->
    <style name="Badge" parent="">
        <item name="android:layout_width">@dimen/badge_size</item>
        <item name="android:layout_height">@dimen/badge_size</item>
        <item name="android:layout_marginEnd">@dimen/button_gap</item>
        <item name="android:background">@drawable/badge_dot</item>
    </style>

    <!-- The row a badge and a service name share. Clickable as one thing: the target is the
         whole row, not the twenty-four pixels of the dot. -->
    <style name="BadgeRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Hairline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/hairline_height</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
        <item name="android:background">@color/hairline</item>
    </style>

    <style name="TonalButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/native_button_selector</item>
        <item name="android:paddingStart">@dimen/native_button_padding_h</item>
        <item name="android:paddingEnd">@dimen/native_button_padding_h</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/button_text_size</item>
    </style>
</resources>
