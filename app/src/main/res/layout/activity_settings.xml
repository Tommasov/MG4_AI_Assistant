<?xml version="1.0" encoding="utf-8"?>
<!-- Settings are the one screen where touching is expected: done once, parked, and then not
     again. Everything else in this app exists to avoid the screen.

     Only buttons carry a tonal face. Fields keep the platform's underline and notices are
     plain text, so that nothing which cannot be pressed looks as though it can. Groups are
     separated by an accent heading and a hairline rather than by boxes — the vocabulary MG4
     360 Camera uses. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chrome_background"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/button_gap"
            android:background="@drawable/native_button_selector"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="@dimen/native_button_padding_v"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/title_size" />

        <Button
            android:id="@+id/button_diagnostics"
            style="@style/TonalButton"
            android:text="@string/action_diagnostics" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_section_cost" />

            <!-- Plain text, deliberately. This app spends the owner's money every time it is
                 used, and that should read as a statement rather than as a control. -->
            <TextView
                android:id="@+id/cost_notice"
                style="@style/Notice"
                android:text="@string/settings_cost_notice" />

            <View style="@style/Hairline" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_section_usage" />

            <TextView
                android:id="@+id/usage_summary"
                style="@style/Notice" />



            <Button
                android:id="@+id/button_usage_reset"
                style="@style/TonalButton"
                android:layout_marginTop="@dimen/row_gap"
                android:text="@string/settings_usage_reset" />

            <View style="@style/Hairline" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_section_keys" />

            <TextView
                android:id="@+id/keys_notice"
                style="@style/Notice" />

            <!-- The keys are shown masked and are themselves the control: tapping one
                 offers to check it again or to forget it. The old screen had a text field per
                 service holding 164 visible characters, which was unreadable, indiscreet with
                 a passenger, and the only way in. -->
            <LinearLayout
                android:id="@+id/key_openai_row"
                style="@style/BadgeRow"
                android:layout_marginTop="@dimen/row_gap">

                <View
                    android:id="@+id/key_openai_badge"
                    style="@style/Badge" />

                <TextView
                    android:id="@+id/key_openai_state"
                    style="@style/Notice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_xai_row"
                style="@style/BadgeRow">

                <View
                    android:id="@+id/key_xai_badge"
                    style="@style/Badge" />

                <TextView
                    android:id="@+id/key_xai_state"
                    style="@style/Notice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp" />
            </LinearLayout>

            <!-- One row for both services. A key states which service it belongs to in its
                 own first characters, so asking first would be asking for something the key
                 already carries. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/key_from_file"
                    style="@style/TonalButton"
                    android:layout_marginEnd="@dimen/button_gap"
                    android:text="@string/key_from_file" />

                <Button
                    android:id="@+id/key_paste"
                    style="@style/TonalButton"
                    android:layout_marginEnd="@dimen/button_gap"
                    android:text="@string/key_paste" />

                <Button
                    android:id="@+id/key_type"
                    style="@style/TonalButton"
                    android:text="@string/key_type" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="@string/settings_keys_hint" />

            <View style="@style/Hairline" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_section_conversation" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_provider"
                    style="@style/TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/button_gap" />

                <Button
                    android:id="@+id/button_model"
                    style="@style/TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/button_gap" />

                <Button
                    android:id="@+id/button_voice"
                    style="@style/TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/speech_notice"
                style="@style/Hint"
                android:text="@string/settings_speech_notice" />

            <View style="@style/Hairline" />

            <TextView
                style="@style/SectionHeader"
                android:text="@string/settings_section_wheel" />

            <!-- Wraps, like every other button on this screen. Stretched across the full
                 width it read as a banner rather than as something to press, and the heading
                 above it already says which button is meant. -->
            <Button
                android:id="@+id/button_wheel"
                style="@style/TonalButton" />

            <TextView
                style="@style/Hint"
                android:text="@string/settings_wheel_explain" />

            <Button
                android:id="@+id/button_listen_open"
                style="@style/TonalButton"
                android:layout_marginTop="@dimen/row_gap" />

            <TextView
                style="@style/Hint"
                android:paddingBottom="@dimen/section_gap"
                android:text="@string/settings_listen_open_explain" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
