<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground on the usual 108x108 canvas.

     A microphone, solid white, on the same diagonal gradient the launcher and the browser
     use. Drawn in a 24x24 space, scaled by 2 to 48 units and shifted by 30 to centre it:
     48 of 108 is 44%, the proportion the launcher's rocket occupies (192px on a 432px
     canvas). It was 66% before, which made this icon read as the heavy one of the set.
     A VectorDrawable group applies its scale before its translate, so those two numbers
     land the artwork inside the mask's safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="30"
        android:translateY="30">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3zM17,11c0,2.76 -2.24,5 -5,5s-5,-2.24 -5,-5H5c0,3.53 2.61,6.43 6,6.92V21h2v-3.08c3.39,-0.49 6,-3.39 6,-6.92h-2z" />
    </group>
</vector>
