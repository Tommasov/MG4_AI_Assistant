<?xml version="1.0" encoding="utf-8"?>
<!-- Dark set, taken from MG4 Simple Launcher rather than invented.
     The text colours and the accent are its values-night palette verbatim; the greys are
     sampled out of the SAIC night artwork it draws with, because the launcher gets its dark
     surfaces from PNGs and not from colour values, so there was nothing to copy — only
     something to measure.

       drawable-night/bg_home.png        #2f2f31 → #2a2a2c, centre #2d2e2e   (the ground)
       drawable-night/bg_normal.png      #585a5e → #444649, centre #4e5154   (a card face)

     An earlier guess at #1c2022 put this app a good deal darker and cooler than the launcher
     beside it, which is exactly the mismatch a shared palette exists to prevent. -->
<resources>
    <color name="text_primary">#f2f5f7</color>
    <color name="text_secondary">#99ffffff</color>

    <!-- Not the daytime blue. #056eff is SAIC's own, and on this charcoal it falls to about
         3:1 where text wants 4.5 — it reads muddy rather than bright. The launcher lifts it at
         night for exactly that reason, and the constructor does the same in its own dark theme
         (vehiclesettings keeps charging_mode_color at #4b8fff by day and #b2cfff at night).
         These are the launcher's night values, taken so the two apps agree. -->
    <color name="accent">#7fb0ff</color>
    <color name="accent_pressed">#5d95e6</color>

    <!-- The tonal buttons invert at night: a wash of white instead of one of black, which
         over a charcoal ground is the difference between a visible surface and none. These
         are the launcher's own night values rather than a colour sampled from its card
         artwork, which is what this used to hold. -->
    <color name="button_surface">#26ffffff</color>
    <color name="button_surface_pressed">#4dffffff</color>
    <!-- An outline does the work at the edges that the wash alone cannot on a dark ground. -->
    <color name="button_border">#33ffffff</color>

    <color name="chrome_background">#2d2e2e</color>
    <color name="page_background">#2d2e2e</color>

    <color name="hairline">#1fffffff</color>
    <!-- Placeholder text at night, from the launcher's own values-night palette. -->
    <color name="text_tertiary">#52ffffff</color>

    <!-- The badge lightens at night, same as MG4 360 Camera's: the day green on a charcoal
         ground reads as a dark smudge rather than as a colour. -->
    <color name="badge_ok">#66bb6a</color>
    <color name="badge_unchecked">#ffb74d</color>
    <color name="badge_off">#26ffffff</color>
</resources>
